{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": { "@loom/plugin-sdk": ["packages/loom-plugin-sdk/src/index.ts"] },
    "resolveJsonModule": true
  },
  "include": ["src", "test", "scripts", "packages", "plugins"]
}
